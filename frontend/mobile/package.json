{
  "name": "asset-gudang-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "validate": "npm run test && npm run typecheck && expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
