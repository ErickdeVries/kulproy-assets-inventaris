# Kosongkan untuk mode demo. API backend memakai prefix /api/v1.
VITE_API_URL=http://localhost:8000/api/v1
# Kompatibel dengan konfigurasi Expo yang dibagi lintas aplikasi
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Opsional untuk fase integrasi Google Maps berikutnya. Jangan commit key asli.
# Batasi key browser berdasarkan domain dan hanya aktifkan API yang diperlukan.
VITE_GOOGLE_MAPS_API_KEY=
